rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- REGLA GLOBAL POR DEFECTO ---
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- REGLAS ESPECÍFICAS ---

    // Regla para la colección 'Usuario'.
    match /Usuario/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Regla para la colección 'Evento'.
    match /Evento/{eventoId} {
      allow create: if request.auth != null;

      // Compara el email del token del usuario autenticado con el valor
      // del campo 'IdUsuario' que ya existe en el documento.
      allow update, delete: if request.auth != null && request.auth.token.email == resource.data.IdUsuario.lower();
    }

    // Regla para la colección 'ClasPart'.
    match /ClasPart/{claseId} {
      allow create: if request.auth != null;

      // Misma lógica que para Evento.
      allow update, delete: if request.auth != null && request.auth.token.email == resource.data.IdUsuario.lower();
    }
  }
}